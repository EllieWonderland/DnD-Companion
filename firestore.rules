rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User-private character data — only the owner can read and write
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Group collections — all authenticated users can read and write
    match /groupChat/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /globalQuests/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /publicGeneralNotes/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /publicGrudgeNotes/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /groupLootItems/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /groupLootCoins/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Lore collections — all authenticated users can read and write
    match /lore/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /loreQuests/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
